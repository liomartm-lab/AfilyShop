rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingStore(storeId) {
      return signedIn() && resource.data.ownerId == request.auth.uid && storeId == request.auth.uid;
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
    }

    match /stores/{storeId} {
      allow read: if resource.data.status == "active" || (signedIn() && request.auth.uid == resource.data.ownerId);
      allow create: if signedIn() && request.auth.uid == storeId && request.resource.data.ownerId == request.auth.uid;
      allow update: if ownsExistingStore(storeId) && request.resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if resource.data.status == "published" || (signedIn() && request.auth.uid == resource.data.ownerId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.resource.data.diff(resource.data).changedKeys().hasOnly(["clicks", "updatedAt"]);
      allow update, delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /clicks/{clickId} {
      allow create: if true;
      allow read: if signedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}
